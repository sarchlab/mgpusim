      "min_non_flat_points_if_hw_non_flat_exists": 5,
      "min_trend_points": 3
    },
    "coverage_status": {
      "full": "The current CSV satisfies the benchmark coverage expectation and point_coverage_ready is true.",
      "partial": "The current CSV does not satisfy the full coverage expectation; point_coverage_ready is false and coverage_gaps list the current deficits."
    },
    "partial_coverage_policy": {
      "policy": "partial_current_data_v1",
      "semantics": "Partial current-data entries are retained for historical/category continuity but do not count as full point-coverage passes in validator/report summaries."
